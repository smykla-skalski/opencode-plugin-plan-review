    "solid-js": ">=1.9.0"
  },
  "dependencies": {
    "beautiful-mermaid": "1.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.20",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/node": "24.19.1",
    "solid-js": "1.9.12",
    "typescript": "7.0.2"
  },
