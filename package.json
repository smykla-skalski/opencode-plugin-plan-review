    "server.ts",
    "tui.tsx",
    "rpc.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "opencode": ">=2.0.19"
  },
  "keywords": [
    "ai",
    "code-review",
    "coding-agent",
    "opencode",
    "opencode-plugin",
    "plan-mode",
    "planning",
    "tui"
